{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/inferno-session-draft.mjs --user-prompt"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/inferno-session-draft.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/inferno-session-draft.mjs --agent-stop"
      }
    ]
  }
}
