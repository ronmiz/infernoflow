node_modules/
**/node_modules/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Build artifacts that don't belong in git (dist/ IS tracked — see package.json files)
*.tsbuildinfo
.cache/

# Editor
.vscode/
.idea/
*.swp
*~

# Test coverage
coverage/
.nyc_output/

# Drafts (per CHANGELOG entry for install-cursor-hooks)
inferno/CONTEXT.draft.md

# Stray packed tarballs
*.tgz

# Legacy paths
/src/

# Local-agent / Claude session scratch
.claude/

# Compiled extension output (vscode-extension keeps src/, build during package)
vscode-extension/out/
vscode-extension/*.vsix.bak
# Built .vsix packages — Marketplace artifacts only, don't bloat git
vscode-extension/*.vsix

# Internal planning docs — NEVER commit
# These are private working docs (analysis scorecards, roadmaps, design drafts).
# They got accidentally swept into commit 88c78d5 once — this block prevents recurrence.
docs/ANALYSIS.md
docs/INFERNOFLOW_EXTENSION_DESIGN.md
docs/INFERNOFLOW_READINESS_PLAN.md
docs/INFERNOFLOW_*_PLAN.md
docs/INFERNOFLOW_*_DESIGN.md
docs/INFERNOFLOW_*.md
infernoflow-roadmap.docx
*.docx

# --- infernoflow (developer-local AI memory; do not commit) ---
# Memory is per-developer, not per-branch. These files travel with you, not with git.
.ai-memory/
.cursorrules
CLAUDE.md
.github/copilot-instructions.md
# MCP server setup — contains absolute paths to local machine; per-developer
.cursor/
.vscode/mcp.json
# Auto-generated per-developer profile
inferno/developer-profile.json
inferno/CONTEXT.draft.md
