{
  "name": "infernoflow",
  "displayName": "infernoflow",
  "description": "Persistent memory for AI coding sessions \u2014 live sidebar over .ai-memory/ (AMP). Captures gotchas, decisions, dead ends and replays them into Cursor / Copilot / Claude / Windsurf.",
  "version": "0.7.0",
  "publisher": "infernoflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronmiz/infernoflow.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other",
    "Notebooks",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "ai-memory",
    "ai-context",
    "session-memory",
    "persistent-memory",
    "agent-memory",
    "agent-handoff",
    "amp",
    "ai-memory-protocol",
    "copilot",
    "cursor",
    "claude",
    "windsurf",
    "infernoflow",
    "gotchas",
    "context-switching"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:.ai-memory/sessions.jsonl",
    "workspaceContains:inferno/contract.json",
    "workspaceContains:inferno/sessions.jsonl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "infernoflow",
          "title": "infernoflow",
          "icon": "media/infernoflow.svg"
        }
      ]
    },
    "views": {
      "infernoflow": [
        {
          "id": "infernoflow.sessionView",
          "name": "Session Memory",
          "icon": "media/infernoflow.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "infernoflow.logGotcha",
        "title": "Log Gotcha",
        "category": "infernoflow",
        "icon": "$(warning)"
      },
      {
        "command": "infernoflow.logDecision",
        "title": "Log Decision",
        "category": "infernoflow",
        "icon": "$(check)"
      },
      {
        "command": "infernoflow.logAttempt",
        "title": "Log Failed Attempt",
        "category": "infernoflow",
        "icon": "$(error)"
      },
      {
        "command": "infernoflow.logNote",
        "title": "Log Note",
        "category": "infernoflow",
        "icon": "$(note)"
      },
      {
        "command": "infernoflow.ask",
        "title": "Ask Memory",
        "category": "infernoflow",
        "icon": "$(search)"
      },
      {
        "command": "infernoflow.switch",
        "title": "Generate Handoff",
        "category": "infernoflow",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "infernoflow.recap",
        "title": "Show Recap",
        "category": "infernoflow",
        "icon": "$(graph)"
      },
      {
        "command": "infernoflow.refresh",
        "title": "Refresh",
        "category": "infernoflow",
        "icon": "$(refresh)"
      },
      {
        "command": "infernoflow.openPanel",
        "title": "Open Session Panel",
        "category": "infernoflow",
        "icon": "$(flame)"
      },
      {
        "command": "infernoflow.migrateAmp",
        "title": "Migrate inferno/ \u2192 .ai-memory/",
        "category": "infernoflow",
        "icon": "$(file-symlink-directory)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "infernoflow.logGotcha",
          "group": "infernoflow@1"
        },
        {
          "command": "infernoflow.logDecision",
          "group": "infernoflow@2"
        }
      ],
      "view/title": [
        {
          "command": "infernoflow.logGotcha",
          "when": "view == infernoflow.sessionView",
          "group": "navigation"
        },
        {
          "command": "infernoflow.switch",
          "when": "view == infernoflow.sessionView",
          "group": "navigation"
        },
        {
          "command": "infernoflow.refresh",
          "when": "view == infernoflow.sessionView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "infernoflow",
      "properties": {
        "infernoflow.cliPath": {
          "type": "string",
          "default": "infernoflow",
          "description": "Path to the infernoflow CLI (used for `switch` and other write-side ops). Default 'infernoflow' must be on PATH."
        },
        "infernoflow.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show session-health summary in the status bar."
        },
        "infernoflow.showDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Surface gotchas as warnings in the Problems panel where files match."
        },
        "infernoflow.notifications": {
          "type": "string",
          "enum": [
            "all",
            "important",
            "none"
          ],
          "default": "important",
          "description": "Notification level (all = every event, important = gotchas only, none = silent)."
        }
      }
    },
    "keybindings": [
      {
        "command": "infernoflow.logGotcha",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "infernoflow.logDecision",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "infernoflow.ask",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "infernoflow.switch",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "infernoflow.recap",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "bugs": {
    "url": "https://github.com/ronmiz/infernoflow/issues"
  },
  "homepage": "https://github.com/ronmiz/infernoflow#readme",
  "galleryBanner": {
    "color": "#f97316",
    "theme": "dark"
  },
  "dependencies": {
    "infernoflow-amp": "^1.0.0"
  }
}
