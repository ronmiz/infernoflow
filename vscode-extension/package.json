{
  "name": "infernoflow",
  "displayName": "infernoflow",
  "description": "Keep capabilities, contracts, and docs in sync — live status panel for VS Code and Cursor",
  "version": "0.5.0",
  "publisher": "infernoflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronmiz/infernoflow.git"
  },
  "bugs": {
    "url": "https://github.com/ronmiz/infernoflow/issues"
  },
  "homepage": "https://github.com/ronmiz/infernoflow#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "infernoflow",
    "capabilities",
    "contracts",
    "documentation",
    "ai",
    "cursor",
    "claude",
    "copilot",
    "developer-tools",
    "liquid-code"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:inferno/contract.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "infernoflow",
          "title": "infernoflow",
          "icon": "media/infernoflow.svg"
        }
      ]
    },
    "views": {
      "infernoflow": [
        {
          "id": "infernoflow.capabilities",
          "name": "Capabilities",
          "icon": "media/infernoflow.svg"
        },
        {
          "id": "infernoflow.scenarios",
          "name": "Scenarios"
        },
        {
          "id": "infernoflow.changelog",
          "name": "Changelog"
        },
        {
          "id": "infernoflow.agents",
          "name": "Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "infernoflow.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.check",
        "title": "Run Check",
        "icon": "$(pass-filled)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.updateContext",
        "title": "Update Context",
        "icon": "$(sync)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.openContext",
        "title": "Open CONTEXT.md",
        "icon": "$(file-text)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.openCapabilities",
        "title": "Open capabilities.json",
        "icon": "$(file-code)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.changelogUpdate",
        "title": "Draft Changelog Entry",
        "icon": "$(edit)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.diff",
        "title": "Show Capability Diff",
        "icon": "$(diff)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.runAgent",
        "title": "Run Agent",
        "icon": "$(play)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.version",
        "title": "Version Recommendation",
        "icon": "$(tag)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.changelogAi",
        "title": "Generate AI Changelog",
        "icon": "$(sparkle)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.dashboard",
        "title": "Open Dashboard",
        "icon": "$(dashboard)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.onboard",
        "title": "Onboarding Wizard",
        "icon": "$(rocket)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.openDashboard",
        "title": "Open Dashboard (Webview)",
        "icon": "$(browser)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.linkCapability",
        "title": "Link Capability to Ticket",
        "icon": "$(link)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.audit",
        "title": "Run Security Audit",
        "icon": "$(shield)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.health",
        "title": "Show Health Score",
        "icon": "$(heart)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.scout",
        "title": "Scout Undocumented Capabilities",
        "icon": "$(search)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.snapshotSave",
        "title": "Save Contract Snapshot",
        "icon": "$(save)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.aiSuggest",
        "title": "AI Sync Contract (Copilot / Claude / GPT / Gemini)",
        "icon": "$(sparkle)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.aiReview",
        "title": "AI Review Staged Changes",
        "icon": "$(comment-discussion)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.quickActions",
        "title": "Quick Actions",
        "icon": "$(flame)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.syncThisFile",
        "title": "Sync infernoflow Contract for This File",
        "icon": "$(sparkle)",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.openGraph",
        "title": "Open Capability Graph",
        "icon": "$(type-hierarchy)",
        "category": "infernoflow"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "infernoflow.refresh",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.check",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.updateContext",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.version",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.changelogAi",
          "when": "view == infernoflow.changelog",
          "group": "navigation"
        },
        {
          "command": "infernoflow.dashboard",
          "when": "view == infernoflow.agents",
          "group": "navigation"
        },
        {
          "command": "infernoflow.openDashboard",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.openGraph",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.linkCapability",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.health",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.audit",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.aiSuggest",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        },
        {
          "command": "infernoflow.aiReview",
          "when": "view == infernoflow.capabilities",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "infernoflow.runAgent",
          "when": "view == infernoflow.agents && viewItem == agent",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "infernoflow.syncThisFile",
          "when": "resourceExtname =~ /\\.(ts|tsx|js|jsx|mjs|py|go|java|cs|rb|swift)$/",
          "group": "infernoflow@1"
        }
      ],
      "editor/context": [
        {
          "command": "infernoflow.syncThisFile",
          "when": "resourceExtname =~ /\\.(ts|tsx|js|jsx|mjs|py|go|java|cs|rb|swift)$/",
          "group": "infernoflow@1"
        }
      ]
    },
    "configuration": {
      "title": "infernoflow",
      "properties": {
        "infernoflow.cliPath": {
          "type": "string",
          "default": "infernoflow",
          "description": "Path to the infernoflow CLI executable. Defaults to 'infernoflow' (must be on PATH), or set an absolute path."
        },
        "infernoflow.autoRefreshInterval": {
          "type": "number",
          "default": 30,
          "description": "How often (in seconds) to auto-refresh the status panel. Set to 0 to disable."
        },
        "infernoflow.autoSyncOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync the capability contract when a mapped source file is saved (3s debounce)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish:marketplace": "node publish.mjs --marketplace",
    "publish:openvsx": "node publish.mjs --openvsx",
    "publish:all": "node publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
