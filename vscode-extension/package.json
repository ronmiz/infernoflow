{
  "name": "infernoflow",
  "displayName": "infernoflow",
  "description": "Persistent memory for AI coding sessions \u2014 live sidebar over .ai-memory/ (AMP). Captures gotchas, decisions, dead ends and replays them into Cursor / Copilot / Claude / Windsurf.",
  "version": "0.7.7",
  "publisher": "infernoflow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ronmiz/infernoflow.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other",
    "Notebooks",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "ai-memory",
    "ai-context",
    "session-memory",
    "persistent-memory",
    "agent-memory",
    "agent-handoff",
    "amp",
    "ai-memory-protocol",
    "copilot",
    "cursor",
    "claude",
    "windsurf",
    "infernoflow",
    "gotchas",
    "context-switching"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "workspaceContains:.ai-memory/sessions.jsonl",
    "workspaceContains:inferno/contract.json",
    "workspaceContains:inferno/sessions.jsonl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "infernoflow",
          "title": "infernoflow",
          "icon": "media/infernoflow.svg"
        }
      ]
    },
    "views": {
      "infernoflow": [
        {
          "id": "infernoflow.sessionView",
          "name": "Session Memory",
          "icon": "media/infernoflow.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "infernoflow.logGotcha",
        "title": "Log Gotcha",
        "category": "infernoflow",
        "icon": "$(warning)"
      },
      {
        "command": "infernoflow.logDecision",
        "title": "Log Decision",
        "category": "infernoflow",
        "icon": "$(check)"
      },
      {
        "command": "infernoflow.logAttempt",
        "title": "Log Failed Attempt",
        "category": "infernoflow",
        "icon": "$(error)"
      },
      {
        "command": "infernoflow.logNote",
        "title": "Log Note",
        "category": "infernoflow",
        "icon": "$(note)"
      },
      {
        "command": "infernoflow.ask",
        "title": "Ask Memory",
        "category": "infernoflow",
        "icon": "$(search)"
      },
      {
        "command": "infernoflow.switch",
        "title": "Generate Handoff",
        "category": "infernoflow",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "infernoflow.recap",
        "title": "Show Recap",
        "category": "infernoflow",
        "icon": "$(graph)"
      },
      {
        "command": "infernoflow.refresh",
        "title": "Refresh",
        "category": "infernoflow",
        "icon": "$(refresh)"
      },
      {
        "command": "infernoflow.openPanel",
        "title": "Open Session Panel",
        "category": "infernoflow",
        "icon": "$(flame)"
      },
      {
        "command": "infernoflow.migrateAmp",
        "title": "Migrate inferno/ \u2192 .ai-memory/",
        "category": "infernoflow",
        "icon": "$(file-symlink-directory)"
      },
      {
        "command": "infernoflow.cliStatus",
        "title": "Status",
        "category": "infernoflow",
        "icon": "$(pulse)"
      },
      {
        "command": "infernoflow.cliCheck",
        "title": "Check (validate contract + memory)",
        "category": "infernoflow",
        "icon": "$(verified)"
      },
      {
        "command": "infernoflow.cliDoctor",
        "title": "Doctor (diagnose setup)",
        "category": "infernoflow",
        "icon": "$(stethoscope)"
      },
      {
        "command": "infernoflow.cliScan",
        "title": "Scan codebase (deep AST)",
        "category": "infernoflow",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "infernoflow.cliInitAdopt",
        "title": "Init project with adopt scan",
        "category": "infernoflow",
        "icon": "$(rocket)"
      },
      {
        "command": "infernoflow.cliSetup",
        "title": "Setup MCP integration",
        "category": "infernoflow",
        "icon": "$(plug)"
      },
      {
        "command": "infernoflow.cliAiSetup",
        "title": "AI setup (configure provider)",
        "category": "infernoflow",
        "icon": "$(sparkle)"
      },
      {
        "command": "infernoflow.cliInstallCursor",
        "title": "Install Cursor hooks",
        "category": "infernoflow",
        "icon": "$(extensions)"
      },
      {
        "command": "infernoflow.cliWatch",
        "title": "Watch (auto-capture mode)",
        "category": "infernoflow",
        "icon": "$(eye)"
      },
      {
        "command": "infernoflow.cliCloudStatus",
        "title": "Cloud status",
        "category": "infernoflow",
        "icon": "$(cloud)"
      },
      {
        "command": "infernoflow.cliContext",
        "title": "Show context",
        "category": "infernoflow",
        "icon": "$(book)"
      },
      {
        "command": "infernoflow.deleteEntry",
        "title": "Delete this entry",
        "category": "infernoflow",
        "icon": "$(trash)"
      },
      {
        "command": "infernoflow.manageEntries",
        "title": "Manage entries (bulk select & delete)",
        "category": "infernoflow",
        "icon": "$(checklist)"
      },
      {
        "command": "infernoflow.cleanupOrphaned",
        "title": "Cleanup orphaned entries (file deleted)",
        "category": "infernoflow",
        "icon": "$(circle-slash)"
      },
      {
        "command": "infernoflow.handleOrphaned",
        "title": "Handle orphaned entry",
        "category": "infernoflow"
      },
      {
        "command": "infernoflow.rebuildAiRules",
        "title": "Rebuild AI rule files (file-prioritized)",
        "category": "infernoflow",
        "icon": "$(refresh)"
      },
      {
        "command": "infernoflow.summarizeSession",
        "title": "Summarize session with AI (preview & save)",
        "category": "infernoflow",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "infernoflow.logGotcha",
          "group": "infernoflow@1"
        },
        {
          "command": "infernoflow.logDecision",
          "group": "infernoflow@2"
        }
      ],
      "view/title": [
        {
          "command": "infernoflow.logGotcha",
          "when": "view == infernoflow.sessionView",
          "group": "navigation"
        },
        {
          "command": "infernoflow.switch",
          "when": "view == infernoflow.sessionView",
          "group": "navigation"
        },
        {
          "command": "infernoflow.refresh",
          "when": "view == infernoflow.sessionView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "infernoflow.deleteEntry",
          "when": "view == infernoflow.sessionView && viewItem == entry",
          "group": "modify@1"
        },
        {
          "command": "infernoflow.deleteEntry",
          "when": "view == infernoflow.sessionView && viewItem == entry-orphaned",
          "group": "modify@1"
        },
        {
          "command": "infernoflow.handleOrphaned",
          "when": "view == infernoflow.sessionView && viewItem == entry-orphaned",
          "group": "modify@2"
        }
      ]
    },
    "configuration": {
      "title": "infernoflow",
      "properties": {
        "infernoflow.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for the extension. Set to false to fully disable infernoflow without uninstalling."
        },
        "infernoflow.cliPath": {
          "type": "string",
          "default": "infernoflow",
          "description": "Path to the infernoflow CLI (used for `switch` and other write-side ops). Default 'infernoflow' must be on PATH."
        },
        "infernoflow.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show session-health summary in the status bar."
        },
        "infernoflow.showDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Surface gotchas as warnings (and failed attempts as info) in the Problems panel where files match."
        },
        "infernoflow.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline memory annotations above files with logged entries (gotcha/decision/attempt counts + per-line indicators)."
        },
        "infernoflow.autoCapture.repeatedEdits": {
          "type": "boolean",
          "default": true,
          "description": "Detect when you edit the same file repeatedly in a short window and prompt to log a gotcha or failed attempt."
        },
        "infernoflow.autoCapture.repeatedEditsThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 50,
          "description": "Number of edits in a 10-minute window that triggers the 'Stuck on something?' prompt."
        },
        "infernoflow.captureSuccessSignals": {
          "type": "boolean",
          "default": true,
          "description": "When auto-capture harvests recent agent conversation, also pull lines containing resolution keywords (got it, fixed, the trick is, etc.). Captures the breakthrough alongside the breakdown. Disable if you find these add noise."
        },
        "infernoflow.autoSyncRules": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuild .cursorrules / CLAUDE.md / .github/copilot-instructions.md whenever memory changes or you switch files. Closes the injection loop so any new AI chat in the same session sees the latest gotchas ranked for the active file. Disable if you prefer to manually click 'Rebuild AI rule files'."
        },
        "infernoflow.notifications": {
          "type": "string",
          "enum": [
            "all",
            "important",
            "none"
          ],
          "default": "important",
          "description": "Notification level (all = every event, important = gotchas only, none = silent)."
        }
      }
    },
    "keybindings": [
      {
        "command": "infernoflow.logGotcha",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "infernoflow.logDecision",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "infernoflow.ask",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "infernoflow.switch",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "infernoflow.recap",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "bugs": {
    "url": "https://github.com/ronmiz/infernoflow/issues"
  },
  "homepage": "https://github.com/ronmiz/infernoflow#readme",
  "galleryBanner": {
    "color": "#f97316",
    "theme": "dark"
  },
  "dependencies": {
    "infernoflow-amp": "^1.0.0"
  }
}
